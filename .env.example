# Shared
COMPOSE_PROJECT_NAME=onec_smart
ENV=dev
LOG_LEVEL=INFO

# Redis (Phase 1 — cache applicatif)
# En développement local sans Docker : redis://localhost:6379/0
# Dans docker-compose : redis://redis:6379/0 (injecté automatiquement via environment)
REDIS_URL=redis://redis:6379/0
REDIS_DEFAULT_TTL=300

# Backend (FastAPI)
POSTGRES_USER=app
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
POSTGRES_DB=onec_cpk
DATABASE_URL=postgresql+asyncpg://app:CHANGE_ME_DB_PASSWORD@db:5432/onec_cpk
UPLOAD_DIR=/data/onec_smart/uploads
# false (défaut sûr) : uploads servis uniquement via l'endpoint authentifié.
SERVE_UPLOADS_PUBLICLY=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
JWT_SECRET=CHANGE_ME_SUPER_LONG_RANDOM
JWT_ISSUER=onec-cpk-api
JWT_AUDIENCE=onec-cpk-frontend
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_ONE_TIME
DEFAULT_USER_PASSWORD=CHANGE_ME_DEFAULT_PASSWORD
MIGRATION_DEFAULT_PASSWORD=
ENABLE_DEBUG_ENDPOINTS=false
REFRESH_COOKIE_NAME=refresh_token
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax
REFRESH_COOKIE_DOMAIN=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://www.onec-rdc.org
CORS_ORIGIN_REGEX=^https://([a-z0-9-]+\\.)?onec-rdc\\.org$
# Reverse-proxies de confiance en amont (rate-limiting via X-Forwarded-For).
# Nginx seul = 1 ; Nginx derrière CloudFront/ALB = 2.
TRUSTED_PROXY_HOPS=1
# Scopes Google OAuth (secrétariat). Absent = gmail.compose seul (recommandé,
# évite l'audit Google CASA). Ajouter gmail.readonly uniquement si lecture de
# boîte requise ET conformité CASA assumée :
# GOOGLE_OAUTH_SCOPES=https://www.googleapis.com/auth/gmail.compose https://www.googleapis.com/auth/gmail.readonly
TENANT_BASE_DOMAIN=onec-rdc.org
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=gemma2:2b

# SMTP (optional fallback if system settings are empty)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@example.com
SMTP_PASSWORD=CHANGE_ME_SMTP_PASSWORD

# Weekly report scheduler
WEEKLY_REPORT_ENABLED=false
WEEKLY_REPORT_TO=secretaire.executif@example.com
WEEKLY_REPORT_CC=
WEEKLY_REPORT_DAY_OF_WEEK=mon
WEEKLY_REPORT_HOUR=7
WEEKLY_REPORT_MINUTE=30
WEEKLY_REPORT_TIMEZONE=Africa/Kinshasa
# Rapport de trésorerie mensuel (mois écoulé, mêmes destinataires et fuseau que l'hebdo)
MONTHLY_TREASURY_REPORT_ENABLED=false
MONTHLY_TREASURY_REPORT_DAY_OF_MONTH=1
MONTHLY_TREASURY_REPORT_HOUR=7
MONTHLY_TREASURY_REPORT_MINUTE=30

# Online payments (ePaieLink)
ONLINE_PAYMENTS_COMPTE_BANCAIRE_ID=
EPAIELINK_API_KEY=CHANGE_ME_EPAIELINK_KEY
EPAIELINK_WEBHOOK_SECRET=CHANGE_ME_EPAIELINK_SECRET
EPAIELINK_BASE_URL=https://api.epaielink.example
EPAIELINK_SITE_ID=CHANGE_ME_SITE_ID
EPAIELINK_NOTIFY_URL=https://api.oneccpk.cd/api/v1/online-payments/webhook/epaielink
EPAIELINK_RETURN_URL=https://oneccpk.cd/payment-success

# Bascule des transferts internes vers le moteur dédié (`transferts_internes`).
# Types de sorties dont l'écriture est déléguée ("versement_banque" et/ou
# "approvisionnement_caisse"), et organisations concernées (vide = toutes
# celles dont le type est ouvert).
# VIDE PAR DÉFAUT : le drapeau est fermé, rien ne change. Le refermer après
# coup n'annule rien — les transferts déjà écrits restent lus où ils sont.
TRANSFERTS_ENGINE_TYPES=
TRANSFERTS_ENGINE_TENANTS=

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_TENANT_BASE_DOMAIN=onec-rdc.org
VITE_PORTAL_ORIGIN=http://localhost:5173
VITE_SECURE_UPLOADS=false
# SaaS console (facturation centralisée)
SAAS_CONSOLE_BASE_URL=http://localhost:8000
SAAS_INTERNAL_KEY=CHANGE_ME_INTERNAL_KEY
SAAS_CHECKOUT_BASE_URL=http://localhost:5173
