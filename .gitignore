# deps
**/node_modules/

# build outputs
/dist/
**/dist/
**/vite.config.*.timestamp-*.mjs

# uploads
**/uploads/

# python
**/__pycache__/
**/*.pyc
**/.venv/

# env files
.env
.env.*

# logs
*.log
*.swp
*.swo
*.swx
*.swn
*.swm

# sauvegardes de base (données réelles : ne jamais versionner)
/backups/
*.dump

# misc
.DS_Store
old.dump
/package-lock.json
frontend/cookies.txt

# secrets / keys
*.pem
*.ppk
*.key

# db dumps
*.sql
!backend/scripts/*.sql
# Les scripts d'observation du harnais de charge sont du code, pas des dumps.
!backend/scripts/**/*.sql
*.sqlite
*.sqlite3

# Claude Code : réglages machine et worktrees temporaires (copie complète du dépôt)
.claude/settings.local.json
.claude/worktrees/

# Sorties de build PyInstaller de l'agent de pointage (binaires generes,
# reconstruits par packaging/ ; ~30 Mo qui n'ont pas leur place dans l'historique)
attendance-agent/dist/
attendance-agent/build/

# Sauvegardes produites a l'execution par l'import budgetaire
# (app/api/v1/endpoints/budget.py:417, mode « replace ») : un instantane des
# postes remplaces, par organisation et par exercice. Ce sont des donnees de
# tenant, pas du code, et elles se regenerent a chaque import.
# NB : dix fichiers org10/org15 sont deja suivis depuis un commit anterieur ;
# cette regle n'agit que sur les suivants.
backend/backups/

# Harnais de charge : sorties locales, jamais du code.
# context.json contient 400 JWT valides (mint_tokens.py --ttl-minutes) : ne doit
# en aucun cas entrer dans l'historique. resultats/ accumule les flux k6 bruts.
backend/scripts/loadtest/k6/context.json
backend/scripts/loadtest/resultats/
