# Database
POSTGRES_USER=app
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
POSTGRES_DB=onec_cpk
DATABASE_URL=postgresql+asyncpg://app:CHANGE_ME_DB_PASSWORD@db:5432/onec_cpk
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# Uploads
UPLOAD_DIR=./app/uploads
# false (défaut sûr) → les fichiers ne sont servis QUE via l'endpoint authentifié
# secure_uploads. Ne passer à true qu'en dev si vous devez servir /uploads en statique.
SERVE_UPLOADS_PUBLICLY=false

# Security
# Générer une valeur forte (>= 32 octets) : python backend/scripts/generate_jwt_secret.py
# Ne JAMAIS réutiliser une valeur d'exemple en production.
JWT_SECRET=CHANGE_ME_STRONG_RANDOM_SECRET
# JWT_ISSUER=onec-cpk-api
JWT_AUDIENCE=onec-cpk-frontend
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# One-time bootstrap password (create the first admin user)
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_ONE_TIME
DEFAULT_USER_PASSWORD=CHANGE_ME_DEFAULT_PASSWORD
MIGRATION_DEFAULT_PASSWORD=
ENABLE_DEBUG_ENDPOINTS=false

# Cookies (dev defaults)
REFRESH_COOKIE_NAME=refresh_token
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax
REFRESH_COOKIE_DOMAIN=

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Nombre de reverse-proxies de confiance en amont, pour extraire l'IP réelle du
# client depuis X-Forwarded-For sans faire confiance à la valeur forgée (utilisé
# par le rate-limiting). Nginx seul = 1 ; Nginx derrière CloudFront/ALB = 2.
TRUSTED_PROXY_HOPS=1

# Scopes Google OAuth du module secrétariat (séparés par des espaces).
# Défaut (variable absente) = gmail.compose UNIQUEMENT (création de brouillons).
# gmail.readonly est un scope RESTREINT qui déclenche l'audit Google CASA Tier 2 :
# ne l'ajouter QUE si la lecture de boîte entrante est nécessaire ET la conformité
# CASA assumée. Exemple pour réactiver la lecture :
# GOOGLE_OAUTH_SCOPES=https://www.googleapis.com/auth/gmail.compose https://www.googleapis.com/auth/gmail.readonly

# App
ENV=dev
LOG_LEVEL=INFO

# Redis cache
# En dev Docker  → redis://redis:6379/0 (hostname = nom du service compose)
# En dev local   → redis://localhost:6379/0
REDIS_URL=redis://redis:6379/0
REDIS_DEFAULT_TTL=300

# Prometheus /metrics
# true  → endpoint /metrics monté (défaut).
# false → endpoint /metrics désactivé (recommandé si Prometheus non configuré).
ENABLE_METRICS=true
# Si défini, GET /metrics exige le header : Authorization: Bearer <token>
# Générer un secret fort : openssl rand -hex 32
# METRICS_TOKEN=CHANGE_ME_METRICS_SECRET

# Alertes email (erreurs 5xx non gérées)
# Laisser vide désactive les alertes ; les erreurs restent loguées en CRITICAL.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=alerts@example.com
# SMTP_PASSWORD=CHANGE_ME_SMTP_PASSWORD

# Alertes Telegram (optionnel — laisser vide pour désactiver)
# Créer un bot via @BotFather, récupérer le token et l'ID du chat/groupe.
# Les alertes 5xx sont envoyées avec rate-limit (1 par type toutes les 5 min).
# TELEGRAM_BOT_TOKEN=CHANGE_ME_BOT_TOKEN
# TELEGRAM_CHAT_ID=CHANGE_ME_CHAT_ID

# ── Console SaaS & Facturation tenant ────────────────────────────────────────
# Sans ces variables, le module billing fonctionne en mode autonome :
# - /billing/summary  → lit plan_type / status_abonnement depuis la DB locale
# - /billing/config   → lit billing_config (JSONB) de l'organisation locale
# - /billing/invoices → retourne {items:[], configured:false} (pas de 503)
# - Le bouton "Payer mon abonnement" reste désactivé (normal)
#
# Pour activer le paiement en ligne, renseigner :
# SAAS_CONSOLE_BASE_URL=https://console.saas.example.com
# SAAS_INTERNAL_KEY=CHANGE_ME_INTERNAL_KEY
# SAAS_CONSOLE_TIMEOUT=20
# SAAS_BILLING_PORTAL_URL=https://portal.saas.example.com
#
# URLs de retour checkout (remplacer par l'URL publique de l'instance)
# SAAS_CHECKOUT_SUCCESS_URL=https://app.example.com/organisation-settings?status=success
# SAAS_CHECKOUT_CANCEL_URL=https://app.example.com/organisation-settings?status=cancel

# ── Couche IA abstraite ───────────────────────────────────────────────────────
# Provider principal : "anthropic" (production) ou "ollama" (local / dev)
AI_PROVIDER=ollama

# Provider de secours si le principal échoue (optionnel)
# AI_FALLBACK_PROVIDER=ollama
# AI_ENABLE_FALLBACK=false

# Taille maximale du contexte envoyé à l'IA (en caractères)
AI_MAX_CONTEXT_CHARS=12000
AI_MAX_RESPONSE_CHARS=4000

# Anthropic — ne jamais commiter de vraie clé API
# Générer une clé sur https://console.anthropic.com
# ANTHROPIC_API_KEY=sk-ant-CHANGE_ME
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_TIMEOUT_SECONDS=60
ANTHROPIC_MAX_TOKENS=4000
ANTHROPIC_TEMPERATURE=0.2

# Ollama — serveur LLM local ou sur réseau privé
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma2:2b
OLLAMA_TIMEOUT_SECONDS=60
